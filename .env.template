DB_USER=database_user_here
DB_PASSWORD=database_password_here
DB_NAME=database_name_here

# Local / direct TCP (used when CLOUD_SQL_CONNECTION_NAME is unset)
DB_HOST=111.222.333.444
DB_PORT=3306

# Cloud Run / GCP: set this to use @google-cloud/cloud-sql-connector
CLOUD_SQL_CONNECTION_NAME=project:region:instance_name
# Example: CLOUD_SQL_CONNECTION_NAME=my-gcp-project:us-east1:my-mysql-instance
# PUBLIC (default) | PRIVATE | PSC
CLOUD_SQL_IP_TYPE=PUBLIC

DB_CONNECTION_LIMIT=5
SERVICE_ACCOUNT=service_account_name@project_name.iam.gserviceaccount.com
BOT_NAME=DISCORD_BOTNAME_HERE
CHANNEL_NAME=CHANNEL_HERE
NODE_ENV=development # vs. production
ENABLE_DETAILED_LOGGING=false # to toggle some of the introspection polling noise
LOG_LEVEL=error
PORT=4000
HOST=0.0.0.0
GCP_PROJECT_ID=your-gcp-project-id
LOG_NAME=lorebot-graphql-api
