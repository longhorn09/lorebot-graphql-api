# Neon serverless Postgres (pooled connection string recommended for Cloud Run)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DB_SCHEMA=lorebot
DB_CONNECTION_LIMIT=5

SERVICE_ACCOUNT=service_account_name@project_name.iam.gserviceaccount.com
BOT_NAME=DISCORD_BOTNAME_HERE
CHANNEL_NAME=CHANNEL_HERE
NODE_ENV=development # vs. production
ENABLE_DETAILED_LOGGING=false # to toggle some of the introspection polling noise
LOG_LEVEL=error
PORT=4000
HOST=0.0.0.0
GCP_PROJECT_ID=your-gcp-project-id
LOG_NAME=lorebot-graphql-api
